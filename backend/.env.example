# Configuração local do backend. Copie para .env (arquivo ignorado pelo Git).
# SQLite é adequado para desenvolvimento local; a URL pode apontar para MySQL.
DATABASE_URL=sqlite:///./zelo.db
APP_NAME=Zelo API
APP_VERSION=2.0.0
APP_DESCRIPTION=API local do projeto Zelo.
APP_ENV=development
# Em desenvolvimento vazio gera uma chave temporária; em produção configure uma chave aleatória com pelo menos 32 caracteres.
ZELO_AUTH_SECRET=
ZELO_AUTH_TOKEN_TTL_SECONDS=28800
ZELO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
